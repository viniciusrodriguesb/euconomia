{$EUCONOMIA_DOMAIN} {
	encode zstd gzip

	@interno path /health /health/*
	respond @interno 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy app:8080
}
